# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection. Omit to use the embedded dev database (PGlite) in ./data.
DATABASE_URL=postgres://aicos:change-me@localhost:5432/aicos

# Required. Signs session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# Required to store API keys from the dashboard (AES-256-GCM). Generate: openssl rand -base64 32
# Losing this key makes stored secrets unreadable; back it up separately from the database.
MASTER_KEY=

# Optional: provider keys as environment variables (keys saved in Settings take precedence).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Code execution for agents: "docker" runs snippets in locked-down containers; anything else disables it.
SANDBOX=disabled

PORT=8787
HOST=127.0.0.1
# Only needed if the dashboard is served from a different origin than the API.
WEB_ORIGIN=

# Optional first-run CEO account for `pnpm seed` (otherwise create it in the dashboard).
CEO_EMAIL=
CEO_PASSWORD=
