# Settings for running the app. `pnpm run bootstrap` copies this to .env and
# fills in JWT_SECRET and MASTER_KEY for you. Never commit .env.

# Signs login sessions. Any long random string.
JWT_SECRET=

# Encrypts API keys and the email password you save in Settings.
# If you lose it, saved keys can't be decrypted (you'd just re-enter them).
MASTER_KEY=

# Database. Leave empty to use the built-in database stored in ./data (good for local use).
# For PostgreSQL, set e.g. postgres://aicos:password@localhost:5432/aicos
DATABASE_URL=

# Address the app listens on. Open http://localhost:8787 in your browser.
PORT=8787
HOST=127.0.0.1

# Optional: model provider keys (you can also add these later in Settings → API keys).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Let agents run code in isolated Docker containers: set to "docker" (needs Docker running).
SANDBOX=disabled

# Only needed if the dashboard is served from a different address than the API.
WEB_ORIGIN=

# Optional: create the CEO account from the command line with `pnpm seed`
# instead of the first-run screen in the browser.
CEO_EMAIL=
CEO_PASSWORD=
